  "rules": [
    {
      "id": "r1",
      "text": "Only bookkeepers assigned to a client may create or edit that client's invoices.",
      "kind": "access",
      "example": "Jane can't edit invoices for clients she isn't assigned to.",
      "source": "draft"
    },
    {
      "id": "r2",
      "text": "An invoice cannot be marked as paid until it has been sent.",
      "kind": "state",
      "example": "Status must be 'Sent' before payment is recorded.",
      "source": "draft"
    },
    {
      "id": "r3",
      "text": "Total payments recorded for an invoice may not exceed the invoice amount.",
      "kind": "integrity",
      "example": "Cannot record $700 payment for $600 invoice.",
      "source": "draft"
    },
    {
      "id": "r4",
      "text": "Clients can only view and download their own invoices.",
      "kind": "access",
      "example": "Smith & Co. can't see ABC Retail's invoices.",
      "source": "draft"
    },
    {
      "id": "r5",
      "text": "Each invoice must have a unique invoice number within the firm.",
      "kind": "integrity",
      "example": "No two invoices can be #1208 for Acme Bookkeeping.",
      "source": "draft"
    }
