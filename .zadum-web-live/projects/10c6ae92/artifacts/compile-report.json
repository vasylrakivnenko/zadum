      {
        "kind": "rule",
        "item": "A client may only view or download invoices that are assigned to their own client profile; they cannot access or view any other client’s invoices or contact info."
      },
      {
        "kind": "rule",
        "item": "Bookkeeper loses access to client/invoices immediately when unassigned."
      },
      {
        "kind": "rule",
        "item": "Archived invoices and client profiles are invisible to clients; only admins can access/restore."
      },
      {
        "kind": "rule",
        "item": "Invoices may only be edited while status is not 'Paid'."
      },
      {
        "kind": "rule",
        "item": "Clients may only view, not edit, their own profile or contact information."
      },
      {
        "kind": "rule",
        "item": "Each invoice must have exactly one assigned bookkeeper."
      },
      {
        "kind": "non_goal",
        "item": "No integrated online payment processing or receiving money directly. Payment is handled outside, with manual marking in-app."
      },
      {
        "kind": "non_goal",
        "item": "No tax filing or advanced accounting beyond basic invoicing."
      },
      {
        "kind": "non_goal",
        "item": "No recurring invoice automation."
      },
      {
        "kind": "non_goal",
        "item": "No client self-service beyond viewing/downloading/paying invoices in the portal."
      }
