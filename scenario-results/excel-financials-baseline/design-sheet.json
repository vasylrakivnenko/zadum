  "rules": [
    {
      "id": "r1",
      "text": "Only the Owner and Bookkeeper may upload or edit spreadsheets and figures; Managers and Accountants can only view.",
      "kind": "access",
      "example": "Manager Jane cannot upload a new Excel file",
      "source": "draft"
    },
    {
      "id": "r2",
      "text": "A Manager may only see figures for the areas assigned to them, not the whole company.",
      "kind": "access",
      "example": "Marketing Manager sees Marketing expenses but not Payroll",
      "source": "draft"
    },
    {
      "id": "r3",
      "text": "A period must be uploaded and mapped before its figures appear on any dashboard.",
      "kind": "state",
      "example": "Q2 2024 shows no totals until its file is uploaded",
      "source": "draft"
    },
    {
      "id": "r4",
      "text": "Once a period is closed, its figures cannot be edited unless it is reopened by the Owner.",
      "kind": "state",
      "example": "Closed Q1 figures are locked from edits",
      "source": "draft"
    },
    {
      "id": "r5",
      "text": "Profit Summary must always equal Revenue Figure minus Expense Figure for the same period.",
      "kind": "integrity",
      "example": "$148,000 − $110,000 must show as $38,000 net",
      "source": "draft"
    },
    {
      "id": "r6",
      "text": "Every Account Line must belong to exactly one Category and one Period.",
      "kind": "integrity",
      "example": "A rent line cannot be left uncategorized",
      "source": "draft"
    },
    {
      "id": "r7",
      "text": "All amounts are recorded in a single currency across all uploads.",
      "kind": "integrity",
      "example": "A euro-denominated line is rejected or converted before import",
      "source": "draft"
    },
    {
      "id": "r8",
      "text": "Re-uploading a file for a period replaces the prior figures rather than adding to them.",
      "kind": "integrity",
      "example": "Uploading Q1 twice does not double revenue",
      "source": "draft"
    },
    {
      "id": "r9",
      "text": "Only the Owner may invite users, assign roles, and change what areas a user can access; Bookkeepers, Managers, and Accountants cannot manage user accounts.",
      "kind": "access",
      "source": "rule_bank"
    },
    {
      "id": "r10",
      "text": "Every upload, correction, and period close/reopen must be recorded with who did it and when, and this history cannot be altered.",
      "kind": "integrity",
      "source": "rule_bank"
    },
    {
      "id": "r11",
      "text": "Each User must have a role and (for Managers) their allowed areas assigned when they are invited.",
      "kind": "integrity",
      "source": "rule_bank"
    },
    {
      "id": "r12",
      "text": "A Category cannot be deleted while Account Lines are still assigned to it; the lines must be reassigned or removed first.",
      "kind": "integrity",
      "source": "rule_bank"
    },
    {
      "id": "r13",
      "text": "An Excel Upload must have a file, a period covered, and an uploader recorded before it can be imported.",
      "kind": "integrity",
      "source": "rule_bank"
    },
    {
      "id": "r14",
      "text": "Each Period label must be unique, so figures are never split across two records for the same month, quarter, or year.",
      "kind": "integrity",
      "source": "rule_bank"
    }
  ],
