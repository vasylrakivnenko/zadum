  "rules": [
    {
      "id": "r1",
      "text": "Only the Owner and Bookkeeper may upload or edit spreadsheet figures; Managers and Accountant see read-only views.",
      "kind": "access",
      "example": "A Manager cannot change an Expense Line amount.",
      "source": "draft"
    },
    {
      "id": "r2",
      "text": "Each Manager may only view budgets and costs for their own Department.",
      "kind": "access",
      "example": "The Sales manager cannot open Operations department costs.",
      "source": "draft"
    },
    {
      "id": "r3",
      "text": "A month's financials cannot be finalized until income and expense lines are both present.",
      "kind": "state",
      "example": "March cannot close while expenses are blank.",
      "source": "draft"
    },
    {
      "id": "r4",
      "text": "Net profit must always equal total income minus total expenses for the same month.",
      "kind": "integrity",
      "example": "March net profit shows $22,700 = $84,200 - $61,500.",
      "source": "draft"
    },
    {
      "id": "r5",
      "text": "Uploading a new spreadsheet for an already-loaded month replaces the prior figures and keeps a record of both uploads.",
      "kind": "integrity",
      "example": "Re-uploading March keeps the Apr 2 and Apr 5 import records.",
      "source": "draft"
    },
    {
      "id": "r6",
      "text": "All amounts are shown in a single currency (USD) and no mixed currencies are allowed.",
      "kind": "integrity",
      "example": "A EUR figure would be rejected on import.",
      "source": "draft"
    },
    {
      "id": "r7",
      "text": "Historical months cannot be edited once the Accountant marks them reviewed.",
      "kind": "state",
      "example": "Once March is reviewed, its lines lock.",
      "source": "draft"
    },
    {
      "id": "r8",
      "text": "There may be only one Monthly Financials record per calendar month, and each Spreadsheet Import must carry a unique file name and month-covered identifier.",
      "kind": "integrity",
      "source": "rule_bank"
    },
    {
      "id": "r9",
      "text": "Every upload, figure edit, budget change, and review action is recorded with who did it and when, and these records cannot be altered or deleted.",
      "kind": "integrity",
      "source": "rule_bank"
    },
    {
      "id": "r10",
      "text": "Every Revenue Line, Expense Line, and Budget must reference a valid existing month/period and (where applicable) an existing Department; no orphaned lines are allowed.",
      "kind": "integrity",
      "source": "rule_bank"
    },
    {
      "id": "r11",
      "text": "Required fields (month, category, and amount) must be provided before a Revenue Line, Expense Line, or Cash Balance is saved.",
      "kind": "integrity",
      "source": "rule_bank"
    },
    {
      "id": "r12",
      "text": "Users interact with financial figures only through the dashboard; direct access to the underlying spreadsheets or data store is not permitted.",
      "kind": "access",
      "source": "rule_bank"
    },
    {
      "id": "r13",
      "text": "A Department cannot be deleted while it still has linked Budgets or Expense Lines assigned to it.",
      "kind": "state",
      "source": "rule_bank"
    }
  ],
