# Copy to `.env` (git-ignored; auto-loaded by every CLI/harness run via src/env.ts).
# LLM credentials (one of): ANTHROPIC_API_KEY, or `ant auth login` profile.
ANTHROPIC_API_KEY=
# Provider: anthropic (default when ANTHROPIC_API_KEY is set) | azure-openai | openai. Auto-detected from keys if unset.
ZADUM_PROVIDER=
# Azure OpenAI (v1 endpoint) / OpenAI-compatible.
# AZURE_OPENAI_ENDPOINT is REQUIRED for azure-openai: endpoints are per-tenant, so the code ships no default.
AZURE_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Azure AI Foundry resource (gpt-4o, Kimi-K2.5, and Claude via its /anthropic route) — used by the model
# registry (src/llm/registry.ts) and the multi-model evals. NOTE: a Foundry resource has its OWN key; the
# AZURE_API_KEY above belongs to a different resource and will 401 here. Check with `npm run models`.
FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com
# The Foundry resource key. This repo's .env calls it LLM2_API_KEY; FOUNDRY_API_KEY is an accepted alias.
LLM2_API_KEY=
FOUNDRY_API_KEY=
# Model tiers. Anthropic defaults: strong=claude-sonnet-5, fast=claude-haiku-4-5. Azure/OpenAI default: gpt-4.1 for both.
ZADUM_MODEL_STRONG=
ZADUM_MODEL_FAST=
# Route the engine's FAST tier to a registry model id (src/llm/registry.ts, e.g. gpt-4o) on its own deployment; strong tier stays on the provider above. Unset = both tiers on the provider.
ZADUM_FAST_MODEL=
# Storage: file store (default) lives in .zadum/; set DATABASE_URL to use Postgres.
DATABASE_URL=
# Cache LLM responses on disk (deterministic replays, cheaper harness runs): 1 to enable
ZADUM_LLM_CACHE=0
# Where the file store keeps data
ZADUM_DATA_DIR=.zadum
# Hosted web security. REQUIRED in production; generate once with `openssl rand -base64 32` and keep it stable.
# Changing it signs every browser out. Projects remain stored but need an ownership migration/recovery process.
ZADUM_AUTH_SECRET=
# 1 ONLY when a reverse proxy that overwrites x-forwarded-for sits in front of the web app. Unset, those
# headers are ignored: they are attacker-supplied, and a spoofable key is not a rate limit at all.
ZADUM_TRUST_PROXY=
# Per-process rate limits. Defaults: create=5/10min per IP, expensive=20/min, write=120/min, read=300/min.
ZADUM_RATE_CREATE=5
ZADUM_RATE_EXPENSIVE=20
ZADUM_RATE_WRITE=120
ZADUM_RATE_READ=300
# Callers nothing can tell apart (no session cookie, no trusted IP) share one bucket at this multiple of the
# limit above — a process-wide backstop, not a per-caller limit. Configure ZADUM_TRUST_PROXY instead.
ZADUM_RATE_SHARED_FACTOR=20
# Model for the ENGINE (drafter, critic, compiler) — any id from src/llm/registry.ts, e.g. claude-opus-4-8.
# Wins over ZADUM_PROVIDER. Without it the engine falls back to Azure OpenAI whenever AZURE_API_KEY is set,
# which meant the product ran on gpt-4.1 while the offline mining tools ran on Opus. Composes with
# ZADUM_FAST_MODEL: strong tier on Opus, fast tier on something cheap for the <2s card-render rule.
ZADUM_MODEL=

# --- Learning loop B plug-ins (all opt-in, harness-gated; see docs/LEARNING.md) ---
# Learned population priors JSON (produced by `npm run learn`), blended into planned nodes at createProject.
ZADUM_PRIORS_FILE=
# Reliability map JSON (recalibration.json from `npm run learn`): tempers REPORTED default confidences.
ZADUM_RECALIBRATION_FILE=
# Design graph JSON (graph.json from `npm run mine:graph`; validate it with `npm run graph:validate`).
# Soft, scoped associations mined from the decision matrix, applied ONCE to newly sampled worlds as a prior.
# Ships OFF: it reweights the belief the selector reasons over, so it needs a graph-on/graph-off harness arm
# before it can be a default. A user answer and the hard catalog rules always win over it.
ZADUM_GRAPH_FILE=
# 1 = the last sampler batch stakes out coherent minority worlds (concentrated-belief countermeasure).
# Ships OFF: shifts belief concentration, so θ + baselines must be re-validated by a live A/B first.
ZADUM_CONTRARIAN=
