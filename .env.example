# Copy to `.env` (git-ignored; auto-loaded by every CLI/harness run via src/env.ts).
# LLM credentials (one of): ANTHROPIC_API_KEY, or `ant auth login` profile.
ANTHROPIC_API_KEY=
# Provider: anthropic (default when ANTHROPIC_API_KEY is set) | azure-openai | openai. Auto-detected from keys if unset.
ZADUM_PROVIDER=
# Azure OpenAI (v1 endpoint) / OpenAI-compatible.
# AZURE_OPENAI_ENDPOINT is REQUIRED for azure-openai: endpoints are per-tenant, so the code ships no default.
AZURE_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Azure AI Foundry resource (gpt-4o, Kimi-K2.5, and Claude via its /anthropic route) — used by the model
# registry (src/llm/registry.ts) and the multi-model evals. NOTE: a Foundry resource has its OWN key; the
# AZURE_API_KEY above belongs to a different resource and will 401 here. Check with `npm run models`.
FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com
# The Foundry resource key. This repo's .env calls it LLM2_API_KEY; FOUNDRY_API_KEY is an accepted alias.
LLM2_API_KEY=
FOUNDRY_API_KEY=
# Model tiers. Anthropic defaults: strong=claude-sonnet-5, fast=claude-haiku-4-5. Azure/OpenAI default: gpt-4.1 for both.
ZADUM_MODEL_STRONG=
ZADUM_MODEL_FAST=
# Route the engine's FAST tier to a registry model id (src/llm/registry.ts, e.g. gpt-4o) on its own deployment; strong tier stays on the provider above. Unset = both tiers on the provider.
ZADUM_FAST_MODEL=
# Storage: file store (default) lives in .zadum/; set DATABASE_URL to use Postgres.
DATABASE_URL=
# Cache LLM responses on disk (deterministic replays, cheaper harness runs): 1 to enable
ZADUM_LLM_CACHE=0
# Where the file store keeps data
ZADUM_DATA_DIR=.zadum
