# Copy to `.env` (git-ignored; auto-loaded by every CLI/harness run via src/env.ts).
# LLM credentials (one of): ANTHROPIC_API_KEY, or `ant auth login` profile.
ANTHROPIC_API_KEY=
# Provider: anthropic (default when ANTHROPIC_API_KEY is set) | azure-openai | openai. Auto-detected from keys if unset.
ZADUM_PROVIDER=
# Azure OpenAI (v1 endpoint) / OpenAI-compatible
AZURE_API_KEY=
AZURE_OPENAI_ENDPOINT=https://ldl.openai.azure.com/openai/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Model tiers. Anthropic defaults: strong=claude-sonnet-5, fast=claude-haiku-4-5. Azure/OpenAI default: gpt-4.1 for both.
ZADUM_MODEL_STRONG=
ZADUM_MODEL_FAST=
# Storage: file store (default) lives in .zadum/; set DATABASE_URL to use Postgres.
DATABASE_URL=
# Cache LLM responses on disk (deterministic replays, cheaper harness runs): 1 to enable
ZADUM_LLM_CACHE=0
# Where the file store keeps data
ZADUM_DATA_DIR=.zadum
